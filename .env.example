# tpass-buddy 環境變數範本。複製成 .env.local 後填真值（.env.local 不進 git）。
# 必填清單的真相＝src/config/auth.ts 的 REQUIRED 陣列，deploy.sh 會照它檢查。

# ── SSO（契約 v2，值由 auth 提供）─────────────────────────────────
AUTH_JWKS_URL=https://auth.lvh.me:3000/.well-known/jwks.json
AUTH_AUTHORIZE_URL=https://auth.lvh.me:3000/api/auth/authorize
AUTH_LOGOUT_URL=https://auth.lvh.me:3000/api/auth/logout
JWT_ISSUER=https://auth.lvh.me:3000
# 選填：未設就由 AUTH_AUTHORIZE_URL 的 origin 推導 /denied
# AUTH_DENIED_URL=https://auth.lvh.me:3000/denied

# ── 本服務 ────────────────────────────────────────────────────────
TPASS_SERVICE_ID=buddy
BUDDY_SELF_URL=https://buddy.lvh.me:3008
PORTAL_URL=https://portal.lvh.me:3001

# 總表 /roster/<token> 的密路徑。用 `openssl rand -hex 16` 產生，正式機與本機各一顆。
# 換掉這顆 env 就等於作廢舊連結。
BUDDY_ROSTER_TOKEN=change-me-openssl-rand-hex-16

# 配對資料固定讀服務目錄下的 data/pairs.json，刻意沒有對應的 env（見 src/lib/pairs.ts）。

# ── 本機 HTTPS 專用（上線刻意不設，主機由 nginx 終結 TLS）────────
TLS_KEY_FILE=../certs/key.pem
TLS_CERT_FILE=../certs/cert.pem
PORT=3008
HOSTNAME=buddy.lvh.me
